[Unit]
Description=Hiralal & Sons - Express API Backend Service
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/hiralal/backend
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=SERVICE_ROLE=api
EnvironmentFile=/etc/hiralal/.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=5
StandardOutput=append:/var/log/hiralal/backend-out.log
StandardError=append:/var/log/hiralal/backend-err.log

# Resource Limits & Sandboxing (Hostinger KVM 2: 8GB RAM budget)
MemoryMax=1024M
TasksMax=100
LimitNOFILE=65536
ProtectSystem=full
ProtectHome=read-only
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
