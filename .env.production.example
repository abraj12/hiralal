# ==============================================================================
# Hiralal & Sons Sales Pvt. Ltd. - Production Environment Configuration Template
# Client: HIRALAL AND SONS SALES PVT. LTD. (CIN: U51909BR2020PTC046116)
# Target Architecture: AWS EC2 t4g.medium (ARM64 / Graviton2, ap-south-1)
# ==============================================================================
# IMPORTANT: Placeholders ONLY. Do NOT commit real secrets to source control.
# Load real credentials at runtime via AWS SSM Parameter Store or Secrets Manager.
# ==============================================================================

NODE_ENV=production
PORT=5000

# 1. PostgreSQL 16+ Credentials (Internal Docker Network)
POSTGRES_USER=hiralal_db_user
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD_MIN_32_CHARS
POSTGRES_DB=hiralal_rewards
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# 2. Redis 7+ Cache & BullMQ Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_STRONG_RANDOM_REDIS_PASSWORD_OPTIONAL

# 3. JWT Authentication Secrets
JWT_ACCESS_SECRET=GENERATE_HIGH_ENTROPY_JWT_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=GENERATE_HIGH_ENTROPY_JWT_REFRESH_SECRET_MIN_64_CHARS
JWT_ADMIN_ACCESS_SECRET=GENERATE_HIGH_ENTROPY_JWT_ADMIN_ACCESS_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# 3b. Administrative Role Configuration & Prefixes
BILL_ADMIN_PREFIX=BADM
OPERATIONS_ADMIN_PREFIX=OADM

# 4. Cryptographic Security & Field-Level Encryption (AES-256-GCM)
ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS_FOR_AES256_SERVER_MASTER_KEY
FIELD_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS_FOR_AES256_FIELD_DATA_KEY
STORAGE_HMAC_SECRET=GENERATE_64_HEX_CHARACTERS_FOR_HMAC_SIGNED_STORAGE_URLS

# 5. Cloudflare R2 Private Document Storage
R2_ACCOUNT_ID=CLOUDFLARE_R2_ACCOUNT_ID_PLACEHOLDER
R2_ACCESS_KEY_ID=CLOUDFLARE_R2_ACCESS_KEY_ID_PLACEHOLDER
R2_SECRET_ACCESS_KEY=CLOUDFLARE_R2_SECRET_ACCESS_KEY_PLACEHOLDER
R2_BUCKET_NAME=hiralal-invoices-private
R2_ENDPOINT="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com"
CLOUDFLARE_R2_PUBLIC_URL=""

# 6. SignCare PAN Verification Provider (Production/UAT)
SIGNCARE_BASE_URL=https://api.signcare.in
SIGNCARE_API_KEY=SIGNCARE_PRODUCTION_API_KEY_PLACEHOLDER
SIGNCARE_APP_ID=SIGNCARE_PRODUCTION_APP_ID_PLACEHOLDER

# 7. RazorpayX Payouts & Fund Account Validation (Hiralal & Sons Account)
RAZORPAYX_KEY_ID=rzp_live_PLACEHOLDER_FOR_HIRALAL_KEY_ID
RAZORPAYX_KEY_SECRET=RAZORPAYX_LIVE_KEY_SECRET_PLACEHOLDER
RAZORPAYX_ACCOUNT_NUMBER=HIRALAL_RAZORPAYX_CURRENT_ACCOUNT_NUMBER
RAZORPAYX_WEBHOOK_SECRET=RAZORPAYX_LIVE_WEBHOOK_SECRET_PLACEHOLDER

# 8. MSG91 SMS Transport Provider
SMS_PROVIDER=MSG91
MSG91_AUTH_KEY=MSG91_PRODUCTION_AUTH_KEY_PLACEHOLDER
MSG91_TEMPLATE_ID=MSG91_REGISTERED_DLT_TEMPLATE_ID
MSG91_SENDER_ID=HIRLAL

# 9. Automated Database Backup Encryption & Offsite Cloudflare R2 Sync
BACKUP_ENCRYPTION_PASSPHRASE=GENERATE_STRONG_PASSPHRASE_FOR_AES256_BACKUP_ENCRYPTION
R2_BACKUP_BUCKET=hiralal-backups-private
RETENTION_DAYS=30

# 10. CORS & Domain Whitelist (Comma-separated)
CORS_ALLOWED_ORIGINS=https://admin.hiralalandsons.com,https://app.hiralalandsons.com
ALLOWED_ORIGINS=https://admin.hiralalandsons.com,https://app.hiralalandsons.com

# 11. Initial Admin Provisioning (Required for seed script fail-fast check)
ADMIN_INITIAL_PASSWORD=GENERATE_STRONG_TEMPORARY_ADMIN_PASSWORD_ROTATED_ON_LOGIN

# 12. Rewards Rules Defaults (Asia/Kolkata Business Parameters)
DEFAULT_REWARD_PERCENTAGE=0.5
MIN_REDEMPTION_AMOUNT=500
# NOTE: Active monthly reward pool caps and active maximum redemption limits are removed.
# Redemptions redeem 100% of available balance subject to minimum threshold.
