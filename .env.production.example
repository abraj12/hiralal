# ==============================================================================
# Hiralal & Sons Sales Pvt. Ltd. - Production Environment Configuration Template
# Client: HIRALAL AND SONS SALES PVT. LTD. (CIN: U51909BR2020PTC046116)
# Target Architecture: Hostinger KVM 2 VPS (2 vCPU, 8 GB RAM, 100 GB NVMe, Ubuntu x86_64)
# ==============================================================================
# IMPORTANT: Placeholders ONLY. Do NOT commit real secrets to source control.
# Load real credentials at runtime via secure host environment (/etc/hiralal/.env) or CI/CD secrets.
# ==============================================================================

NODE_ENV=production
PORT=5000

# 1. PostgreSQL 16+ Credentials (Internal Docker Network)
POSTGRES_USER=hiralal_db_user
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD_MIN_32_CHARS
POSTGRES_DB=hiralal_rewards
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# 2. Redis 7+ Cache & BullMQ Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=GENERATE_HIGH_ENTROPY_REDIS_PASSWORD_MIN_24_CHARS

# 3. JWT Authentication Secrets
JWT_ACCESS_SECRET=GENERATE_HIGH_ENTROPY_JWT_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=GENERATE_HIGH_ENTROPY_JWT_REFRESH_SECRET_MIN_64_CHARS
JWT_ADMIN_ACCESS_SECRET=GENERATE_HIGH_ENTROPY_JWT_ADMIN_ACCESS_SECRET_MIN_64_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# 3b. Administrative Role Configuration & Prefixes
BILL_ADMIN_PREFIX=REPLACE_WITH_RANDOM_BILL_ADMIN_PREFIX_MIN_16_CHARS
OPERATIONS_ADMIN_PREFIX=REPLACE_WITH_RANDOM_OPERATIONS_ADMIN_PREFIX_MIN_16_CHARS

# 4. Cryptographic Security & Field-Level Encryption (AES-256-GCM)
ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS_FOR_AES256_SERVER_MASTER_KEY
FIELD_ENCRYPTION_KEY=GENERATE_64_HEX_CHARACTERS_FOR_AES256_FIELD_DATA_KEY
BLIND_INDEX_SECRET=GENERATE_64_HEX_CHARACTERS_FOR_HMAC_BLIND_INDEXING
STORAGE_HMAC_SECRET=GENERATE_64_HEX_CHARACTERS_FOR_HMAC_SIGNED_STORAGE_URLS
OTP_HMAC_SECRET=GENERATE_64_HEX_CHARACTERS_FOR_HMAC_OTP_HASHING

# 5. Cloudflare R2 Private Document Storage
R2_ACCOUNT_ID=CLOUDFLARE_R2_ACCOUNT_ID_PLACEHOLDER
R2_ACCESS_KEY_ID=CLOUDFLARE_R2_ACCESS_KEY_ID_PLACEHOLDER
R2_SECRET_ACCESS_KEY=CLOUDFLARE_R2_SECRET_ACCESS_KEY_PLACEHOLDER
R2_BUCKET_NAME=hiralal-invoices-private
R2_ENDPOINT="https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com"

# 6. SignCare PAN Verification Provider (Production Only — Fail Closed, HTTPS required, no UAT/sandbox)
SIGNCARE_BASE_URL=https://api.signcare.in
SIGNCARE_API_KEY=SIGNCARE_PRODUCTION_API_KEY_PLACEHOLDER
SIGNCARE_APP_ID=SIGNCARE_PRODUCTION_APP_ID_PLACEHOLDER

# 7. RazorpayX Payouts & Fund Account Validation (Hiralal & Sons Account)
RAZORPAYX_KEY_ID=rzp_live_PLACEHOLDER_FOR_HIRALAL_KEY_ID
RAZORPAYX_KEY_SECRET=RAZORPAYX_LIVE_KEY_SECRET_PLACEHOLDER
RAZORPAYX_ACCOUNT_NUMBER=HIRALAL_RAZORPAYX_CURRENT_ACCOUNT_NUMBER
RAZORPAYX_WEBHOOK_SECRET=RAZORPAYX_LIVE_WEBHOOK_SECRET_PLACEHOLDER

# 8. WhatsApp Business Platform Cloud API (Phone Verification OTP)
OTP_PROVIDER=WHATSAPP
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=WHATSAPP_PRODUCTION_PHONE_NUMBER_ID_PLACEHOLDER
WHATSAPP_ACCESS_TOKEN=WHATSAPP_PRODUCTION_PERMANENT_ACCESS_TOKEN_PLACEHOLDER
WHATSAPP_BUSINESS_ACCOUNT_ID=WHATSAPP_PRODUCTION_WABA_ID_PLACEHOLDER
WHATSAPP_TEMPLATE_NAME=hiralal_auth_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_AUTH_BUTTON_TYPE=COPY_CODE

# Optional Legacy MSG91 SMS Transport Fallback
MSG91_AUTH_KEY=MSG91_PRODUCTION_AUTH_KEY_PLACEHOLDER
MSG91_TEMPLATE_ID=MSG91_REGISTERED_DLT_TEMPLATE_ID
MSG91_SENDER_ID=HIRLAL

# 9. Automated Database Backup Encryption & Offsite Cloudflare R2 Sync
BACKUP_ENCRYPTION_PASSPHRASE=GENERATE_STRONG_PASSPHRASE_FOR_AES256_BACKUP_ENCRYPTION
R2_BACKUP_BUCKET=hiralal-backups-private
RETENTION_DAYS=30

# 10. Public URLs & CORS Origins
PUBLIC_APP_URL=https://hsspl.algions.in
CORS_ALLOWED_ORIGINS=https://hsspl.algions.in
ALLOWED_ORIGINS=https://hsspl.algions.in
# Canonical Production API contract (Android release candidate requires HSSPL_PRODUCTION_API_URL=https://hsspl.algions.in/api/v1)
EXPO_PUBLIC_API_URL=https://hsspl.algions.in/api/v1

# 11. Initial Admin Provisioning & Two Admin Architecture (BILL_ADMIN & OPERATIONS_ADMIN only)
BILL_ADMIN_MOBILE=REPLACE_WITH_PRODUCTION_BILL_ADMIN_10DIGIT_MOBILE
OPERATIONS_ADMIN_MOBILE=REPLACE_WITH_PRODUCTION_OPERATIONS_ADMIN_10DIGIT_MOBILE
BILL_ADMIN_INITIAL_PASSWORD=GENERATE_STRONG_TEMPORARY_BILL_ADMIN_PASSWORD
OPERATIONS_ADMIN_INITIAL_PASSWORD=GENERATE_STRONG_TEMPORARY_OPERATIONS_ADMIN_PASSWORD
ADMIN_ACCESS_TOKEN_EXPIRES_IN=1d

# 11b. Security Thresholds & Operational Limits
AUTH_LOCKOUT_SECONDS=900
AUTH_MAX_FAILED_ATTEMPTS=10
OTP_TTL_SECONDS=300
BILL_MAX_UPLOAD_SIZE_MB=10
BILL_MAX_AMOUNT=50000000
R2_SIGNED_URL_TTL_SECONDS=1800
UPLOADS_DIR=/app/uploads
ACCOUNT_DELETION_COOLDOWN_DAYS=30
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=7
WORKER_PAYOUT_POLL_INTERVAL_MS=5000
WORKER_RECONCILIATION_INTERVAL_MS=180000
WORKER_DELETION_INTERVAL_MS=60000
KYC_RATE_LIMIT=5
KYC_RATE_WINDOW_SECONDS=3600
PAYMENT_VERIFY_RATE_LIMIT=5
PAYMENT_VERIFY_WINDOW_SECONDS=3600
PAYOUT_REDEEM_RATE_LIMIT=3
PAYOUT_REDEEM_WINDOW_SECONDS=60
APP_TIMEZONE=Asia/Kolkata

# 12. Rewards Rules & Redemption Settings (Dynamic & Configured by Operations Admin)
# NOTE: There is NO hardcoded reward percentage default (e.g. 0.5% is removed).
# Operations Admin configures versioned reward rules and minimum redemption threshold via admin interface.
# Redemptions require both minimum balance threshold and active eligibility window.

# 13. Firebase Cloud Messaging (FCM HTTP v1) Push Notifications
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY="REPLACE_WITH_FIREBASE_PRIVATE_KEY"
# Alternatively, specify path to service account JSON:
# FIREBASE_SERVICE_ACCOUNT_KEY="/etc/hiralal/firebase-service-account.json"

# 14. Google Play Integrity API Verification (Android Anti-Tamper & Security Attestation)
PLAY_INTEGRITY_CLIENT_EMAIL=REPLACE_WITH_PLAY_INTEGRITY_CLIENT_EMAIL
PLAY_INTEGRITY_PRIVATE_KEY="REPLACE_WITH_PLAY_INTEGRITY_PRIVATE_KEY"
PLAY_INTEGRITY_PACKAGE_NAME=com.hiralal.rewards
PLAY_INTEGRITY_ALLOWED_CERT_DIGESTS=REPLACE_WITH_SHA256_CERT_DIGEST
PLAY_INTEGRITY_ALLOW_MOCK=false
PLAY_INTEGRITY_REQUIRE_LICENSING=true
PLAY_INTEGRITY_ENFORCE_ACTIONS=true


