# Dedicated Prisma Migration Runner for Hiralal & Sons Rewards Platform
# Retains pinned Prisma CLI and generated client for safe, isolated database migrations.
# Optimized for linux/arm64 (AWS Graviton2) and linux/amd64.
FROM --platform=$BUILDPLATFORM node:22-alpine AS builder

WORKDIR /app

RUN apk add --no-cache \
    openssl \
    libc6-compat

COPY migration-runner/package.json \
     migration-runner/package-lock.json ./

RUN npm ci --omit=dev \
    && npm audit --omit=dev --audit-level=high

COPY prisma ./prisma/

RUN npx prisma generate

# Final lean runner image for target architecture (ARM64 or AMD64)
FROM node:22-alpine AS runner
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision="${VCS_REF}"

WORKDIR /app

RUN apk add --no-cache \
    openssl \
    libc6-compat \
    dumb-init

COPY migration-runner/package.json \
     migration-runner/package-lock.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY prisma ./prisma/

RUN chown -R node:node /app

USER node

ENTRYPOINT ["/usr/bin/dumb-init", "--"]
CMD ["npx", "prisma", "migrate", "deploy"]
