PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:REPLACE_WITH_POSTGRES_PASSWORD@localhost:5432/hiralal_rewards?schema=public"

# Authentication
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_SECRET
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=REPLACE_WITH_64_CHAR_HEX_REFRESH_TOKEN_SECRET

# Cloudflare R2 / S3 Private Storage
CLOUDFLARE_R2_ACCOUNT_ID=REPLACE_WITH_CF_ACCOUNT_ID
CLOUDFLARE_R2_ACCESS_KEY_ID=REPLACE_WITH_CF_R2_ACCESS_KEY_ID
CLOUDFLARE_R2_SECRET_ACCESS_KEY=REPLACE_WITH_CF_R2_SECRET_ACCESS_KEY
CLOUDFLARE_R2_BUCKET_NAME=hiralal-invoices-private
CLOUDFLARE_R2_PUBLIC_URL=https://storage.hiralalandsons.com

# RazorpayX Payouts & Verification
RAZORPAYX_KEY_ID=REPLACE_WITH_RAZORPAYX_KEY_ID
RAZORPAYX_KEY_SECRET=REPLACE_WITH_RAZORPAYX_KEY_SECRET
RAZORPAYX_ACCOUNT_NUMBER=REPLACE_WITH_RAZORPAYX_ACCOUNT_NUMBER
RAZORPAYX_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAYX_WEBHOOK_SECRET

# KYC Provider (Surepass / Karza / Zoop / Mock)
KYC_PROVIDER=MOCK
KYC_API_KEY=REPLACE_WITH_KYC_API_KEY

# Indian SMS Gateway (Fast2SMS / Msg91 / Textlocal / Mock)
SMS_GATEWAY_PROVIDER=MOCK
SMS_API_KEY=REPLACE_WITH_SMS_API_KEY

# Redis Cache & BullMQ Queue
REDIS_URL=redis://localhost:6379

# Field-Level AES-256-GCM Encryption Key (64-char Hex string for 32 bytes)
FIELD_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_FIELD_ENCRYPTION_KEY

# HMAC Secret for signed storage access URLs
STORAGE_HMAC_SECRET=REPLACE_WITH_SECURE_STORAGE_HMAC_SECRET

# Initial Admin Password (Required for production database seed)
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://admin.hiralalandsons.com,http://localhost:3000,http://localhost:5173

# Rewards Business Rules
DEFAULT_REWARD_PERCENTAGE=0.5
MONTHLY_REWARD_POOL_CAP=50000
MIN_REDEMPTION_AMOUNT=500
