PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hiralal_rewards?schema=public"

# Authentication
JWT_SECRET=hiralal_super_secret_jwt_key_2026_rewards_secure
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=hiralal_refresh_token_secret_2026_secure

# Cloudflare R2 / S3 Private Storage
CLOUDFLARE_R2_ACCOUNT_ID=cf_acc_hiralal_sales_r2
CLOUDFLARE_R2_ACCESS_KEY_ID=r2_access_key_placeholder
CLOUDFLARE_R2_SECRET_ACCESS_KEY=r2_secret_key_placeholder
CLOUDFLARE_R2_BUCKET_NAME=hiralal-invoices-private
CLOUDFLARE_R2_PUBLIC_URL=https://storage.hiralalandsons.com

# RazorpayX Payouts & Verification
RAZORPAYX_KEY_ID=rzp_test_hiralal2026
RAZORPAYX_KEY_SECRET=rzp_secret_hiralal2026
RAZORPAYX_ACCOUNT_NUMBER=2323230041123456
RAZORPAYX_WEBHOOK_SECRET=webhook_secret_hiralal_rzpx_2026

# KYC Provider (Surepass / Karza / Zoop / Mock)
KYC_PROVIDER=MOCK
KYC_API_KEY=kyc_api_key_placeholder

# Indian SMS Gateway (Fast2SMS / Msg91 / Textlocal / Mock)
SMS_GATEWAY_PROVIDER=MOCK
SMS_API_KEY=sms_api_key_placeholder

# Redis Cache & BullMQ Queue
REDIS_URL=redis://localhost:6379

# Field-Level AES-256-GCM Encryption Key (64-char Hex string for 32 bytes)
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# HMAC Secret for signed storage access URLs
STORAGE_HMAC_SECRET=hiralal_secure_storage_hmac_signing_key_2026

# Initial Admin Password (Required for production database seed)
ADMIN_INITIAL_PASSWORD=HiralalAdminSecure2026!

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=https://admin.hiralalandsons.com,http://localhost:3000,http://localhost:5173

# Rewards Business Rules
DEFAULT_REWARD_PERCENTAGE=0.5
MONTHLY_REWARD_POOL_CAP=50000
MIN_REDEMPTION_AMOUNT=500

