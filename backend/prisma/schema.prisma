generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Profession {
  PLUMBER
  TILE_INSTALLER
}

enum UserRole {
  USER
  BILL_ADMIN
  OPERATIONS_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum BillStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  DUPLICATE
  CANCELLED
}

enum TransactionType {
  REWARD_CREDIT
  PAYOUT_DEBIT
  PAYOUT_REVERSAL
  MANUAL_ADJUSTMENT
  REFUND
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentType {
  UPI
  BANK_ACCOUNT
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAYOUT_INITIATED
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum OtpPurpose {
  REGISTRATION
  FORGOT_PASSWORD
  LOGIN
  ADMIN_LOGIN
  ACCOUNT_DELETION
}

enum WelcomeDeliveryStatus {
  PENDING
  SENDING
  ACCEPTED
  DELIVERED
  FAILED_RETRYABLE
}

enum DeletionOperationStatus {
  PENDING
  IN_PROGRESS
  FAILED_RETRYABLE
  COMPLETED
  CANCELLED
}

model User {
  id                          String      @id @default(uuid())
  mobile                      String      @unique
  fullName                    String
  firstName                   String?
  middleName                  String?
  lastName                    String?
  isNameLocked                Boolean     @default(false)
  nameLockedAt                DateTime?
  passwordHash                String
  profession                  Profession?
  role                        UserRole    @default(USER)
  status                      UserStatus  @default(ACTIVE)
  isVerified                  Boolean     @default(false)
  activeSessionId             String?
  failedPasswordAttempts      Int         @default(0)
  lockedUntil                 DateTime?
  deletionRequestedAt         DateTime?
  deletionScheduledAt         DateTime?
  lastDeletionRequestAt       DateTime?
  statutoryRetentionExpiresAt DateTime?
  legalHold                   Boolean     @default(false)
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt

  wallet                    Wallet?
  bills                     Bill[]
  kycRecords                KycRecord[]
  paymentAccounts           PaymentAccount[]
  payouts                   Payout[]
  notifications             Notification[]
  pushDeviceTokens          PushDeviceToken[]
  notificationCampaigns     NotificationCampaign[]
  auditLogs                 AuditLog[]
  sessions                  AuthSession[]
  appInstallations          AppInstallation[]
  accountDeletionOperations AccountDeletionOperation[]

  @@index([profession])
  @@index([role])
  @@index([statutoryRetentionExpiresAt])
  @@index([deletionScheduledAt, status, legalHold])
}

model AuthSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?
  tokenHash   String    @unique
  userAgent   String?
  ipAddress   String?
  rotatedFrom String?
  revokedAt   DateTime?
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([sessionId])
}

model VerificationToken {
  id        String   @id @default(uuid())
  mobile    String
  tokenHash String   @unique
  purpose   String // REGISTRATION, PASSWORD_RESET
  isUsed    Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([mobile])
}

model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  availableBalance Decimal  @default(0.0) @db.Decimal(12, 2)
  processingAmount Decimal  @default(0.0) @db.Decimal(12, 2)
  totalRedeemed    Decimal  @default(0.0) @db.Decimal(12, 2)
  deficitLiability Decimal  @default(0.0) @db.Decimal(12, 2)
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt

  transactions WalletTransaction[]
  payouts      Payout[]
}

model WalletTransaction {
  id            String          @id @default(uuid())
  walletId      String
  wallet        Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  userId        String
  amount        Decimal         @db.Decimal(12, 2)
  type          TransactionType
  balanceAfter  Decimal         @db.Decimal(12, 2)
  referenceType String // BILL, PAYOUT, ADMIN
  referenceId   String
  description   String
  createdAt     DateTime        @default(now())

  @@index([walletId])
  @@index([userId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@index([type, createdAt])
  @@index([userId, type])
}

model Bill {
  id                   String      @id @default(uuid())
  userId               String
  user                 User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  invoiceNumber        String
  invoiceDate          DateTime
  billAmount           Decimal     @db.Decimal(12, 2)
  grossBillAmount      Decimal?    @db.Decimal(12, 2)
  gstIncluded          Boolean     @default(false)
  gstRate              Decimal?    @db.Decimal(5, 2)
  gstAmount            Decimal?    @db.Decimal(12, 2)
  eligibleRewardAmount Decimal?    @db.Decimal(12, 2)
  calculatedReward     Decimal     @db.Decimal(12, 2)
  rewardPercentage     Decimal?    @db.Decimal(5, 2)
  rewardRateSnapshot   Decimal?    @db.Decimal(5, 2)
  rewardRuleId         String?
  rewardRule           RewardRule? @relation(fields: [rewardRuleId], references: [id], onDelete: SetNull)
  gstRuleId            String?
  gstRule              GstRule?    @relation(fields: [gstRuleId], references: [id], onDelete: SetNull)
  gstOverrideReason    String?
  status               BillStatus  @default(PENDING)
  fileUrl              String
  fileKey              String
  fileHash             String?     @unique
  fileSize             Int?
  mimeType             String?
  rejectionReason      String?
  verifiedByAdminId    String?
  remarks              String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  parentBillId               String?
  parentBill                 Bill?       @relation("BillRevisions", fields: [parentBillId], references: [id], onDelete: Restrict)
  childRevisions             Bill[]      @relation("BillRevisions")
  revisionNumber             Int         @default(1)
  cancellationReason         String?
  cancelledByAdminId         String?
  cancelledAt                DateTime?
  requiresSecondaryApproval  Boolean     @default(false)
  secondaryApprovedByAdminId String?
  secondaryApprovedAt        DateTime?

  @@unique([userId, invoiceNumber, revisionNumber], name: "user_invoice_revision_unique")
  @@index([parentBillId])
  @@index([userId])
  @@index([status])
  @@index([invoiceNumber])
  @@index([rewardRuleId])
  @@index([gstRuleId])
  @@index([createdAt])
}

model RewardRule {
  id               String     @id @default(uuid())
  profession       Profession
  rewardPercentage Decimal    @db.Decimal(5, 2)
  effectiveFrom    DateTime   @default(now())
  effectiveUntil   DateTime?
  isActive         Boolean    @default(true)
  version          Int        @default(1)
  createdByAdminId String?
  updatedByAdminId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  bills Bill[]

  @@unique([profession, version])
  @@index([profession, isActive])
  @@index([effectiveFrom, effectiveUntil])
}

model GstRule {
  id               String    @id @default(uuid())
  ratePercentage   Decimal   @db.Decimal(5, 2)
  description      String?
  isDefault        Boolean   @default(false)
  isActive         Boolean   @default(true)
  effectiveFrom    DateTime  @default(now())
  effectiveUntil   DateTime?
  createdByAdminId String?
  updatedByAdminId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bills Bill[]

  @@index([isActive])
}

model RedemptionSettings {
  id                      String      @id @default("default")
  profession              Profession? @unique
  isEnabled               Boolean     @default(false)
  minimumRedemptionAmount Decimal?    @db.Decimal(12, 2)
  maximumRedemptionAmount Decimal?    @db.Decimal(12, 2)
  startAt                 DateTime?
  endAt                   DateTime?
  message                 String      @default("Rewards redemption is currently unavailable.")
  updatedByAdminId        String?
  updatedAt               DateTime    @updatedAt
}

model KycRecord {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  panNumber          String?
  panName            String
  panStatus          KycStatus @default(PENDING)
  maskedPan          String
  panNumberEncrypted String?
  panBlindIndex      String?   @unique
  provider           String    @default("SIGNCARE")
  providerRequestId  String?
  consent            Boolean   @default(false)
  consentText        String?
  consentTimestamp   DateTime  @default(now())
  verifiedName       String?
  nameMatched        Boolean   @default(false)
  verifiedAt         DateTime?
  rejectionReason    String?
  mononymousApproved Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

model PaymentAccount {
  id                     String      @id @default(uuid())
  userId                 String
  user                   User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  accountType            PaymentType
  upiId                  String?
  upiIdEncrypted         String?
  beneficiaryBlindIndex  String?     @unique
  accountHolderName      String?
  providerRegisteredName String?
  providerNameVerified   Boolean     @default(false)
  accountNumber          String?
  accountNumberEncrypted String?
  ifscCode               String?
  bankName               String?
  maskedInfo             String
  isVerified             Boolean     @default(false)
  verifiedAt             DateTime?
  isDefault              Boolean     @default(true)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  payouts                Payout[]

  @@index([userId])
  @@index([ifscCode])
}

model Payout {
  id                     String         @id @default(uuid())
  userId                 String
  user                   User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId               String
  wallet                 Wallet         @relation(fields: [walletId], references: [id], onDelete: Restrict)
  amount                 Decimal        @db.Decimal(12, 2)
  paymentAccountId       String
  paymentAccount         PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  paymentType            PaymentType
  idempotencyKey         String
  status                 PayoutStatus   @default(PENDING)
  approvedByAdminId      String?
  approvedAt             DateTime?
  adminRejectionReason   String?
  razorpayPayoutId       String?        @unique
  razorpayFundAccountId  String?
  failureReason          String?
  initiatedAt            DateTime?
  completedAt            DateTime?
  reconciliationAttempts Int            @default(0)
  lastReconciledAt       DateTime?
  requiresManualReview   Boolean        @default(false)
  manualReviewReason     String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@unique([userId, idempotencyKey], name: "user_payout_idempotency_unique")
  @@index([userId])
  @@index([walletId])
  @@index([paymentAccountId])
  @@index([status])
  @@index([requiresManualReview])
  @@index([status, requiresManualReview, updatedAt])
}

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String // PAYOUT_DISPATCH, NOTIFICATION_DISPATCH
  payload     Json
  status      String    @default("PENDING") // PENDING, PROCESSING, PROCESSED, FAILED
  attempts    Int       @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

model WebhookEvent {
  id                  String    @id @default(uuid())
  provider            String // RAZORPAYX
  eventId             String
  eventType           String
  payload             Json
  isProcessed         Boolean   @default(false)
  processingStartedAt DateTime?
  attempts            Int       @default(0)
  lastError           String?
  processedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([provider, eventId], name: "provider_event_unique")
  @@index([isProcessed, processingStartedAt])
}

model OtpRequest {
  id            String     @id @default(uuid())
  mobile        String
  otpHash       String
  purpose       OtpPurpose
  attemptsCount Int        @default(0)
  isUsed        Boolean    @default(false)
  expiresAt     DateTime
  cooldownUntil DateTime?
  createdAt     DateTime   @default(now())

  @@index([mobile])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  oldValue   String?
  newValue   String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String    @default("GENERAL")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  metadata  Json?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
}

model PushDeviceToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("ANDROID") // ANDROID, IOS, WEB
  isActive   Boolean  @default(true)
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model NotificationCampaign {
  id               String   @id @default(uuid())
  title            String
  message          String
  targetAudience   String   @default("ALL") // ALL, PLUMBER, TILE_WORKER, USER
  recipientCount   Int      @default(0)
  createdByAdminId String
  createdByAdmin   User     @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  idempotencyKey   String?  @unique
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([createdByAdminId])
  @@index([createdAt])
}

model AppInstallation {
  id             String                @id @default(uuid())
  installationId String                @unique
  userId         String?
  user           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  platform       String                @default("ANDROID")
  pushToken      String?
  appVersion     String?
  welcomeSentAt  DateTime?
  welcomeStatus  WelcomeDeliveryStatus @default(PENDING)
  claimId        String?
  claimExpiresAt DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([userId])
  @@index([welcomeStatus])
}

model AccountDeletionOperation {
  id                   String                  @id @default(uuid())
  userId               String
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               DeletionOperationStatus @default(PENDING)
  scheduledFor         DateTime
  startedAt            DateTime?
  destructiveStartedAt DateTime?
  completedAt          DateTime?
  attemptCount         Int                     @default(0)
  nextRetryAt          DateTime?
  lastError            String?
  deletedFilesCount    Int                     @default(0)
  failedFileKeys       Json?
  leaseOwner           String?
  leaseVersion         Int                     @default(0)
  leaseExpiresAt       DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
  @@index([nextRetryAt])
  @@index([leaseOwner])
}
