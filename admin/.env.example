# Next.js Administrative Portal Environment Variables
# In production with reverse proxy, same-origin /api/v1 is recommended
NEXT_PUBLIC_API_URL=/api/v1

# Admin Role Identifier Prefixes (Must match backend BILL_ADMIN_PREFIX and OPERATIONS_ADMIN_PREFIX)
NEXT_PUBLIC_BILL_ADMIN_PREFIX=BADM
NEXT_PUBLIC_OPERATIONS_ADMIN_PREFIX=OADM
