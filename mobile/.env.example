# Hiralal & Sons Mobile App Environment Configuration Example
#
# Physical Phone / Expo Go over local Wi-Fi:
# Set your laptop's Wi-Fi IP address (e.g. http://10.205.173.1:5000/api)
EXPO_PUBLIC_API_URL=http://10.205.173.1:5000/api

# Android Studio Emulator (QEMU loopback):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api

# Production Canonical API Endpoint:
# EXPO_PUBLIC_API_URL=https://hsspl.algions.in/api/v1
# EXPO_PUBLIC_ALLOWED_API_HOST=hsspl.algions.in

# Operational Client Limits (Must match backend configuration)
EXPO_PUBLIC_BILL_MAX_UPLOAD_SIZE_MB=10
EXPO_PUBLIC_BILL_MAX_AMOUNT=50000000

# Administrative Client Role Prefixes
EXPO_PUBLIC_BILL_ADMIN_PREFIX=BADM
EXPO_PUBLIC_OPS_ADMIN_PREFIX=OADM
