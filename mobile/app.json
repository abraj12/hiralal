{
  "expo": {
    "name": "Hiralal & Sons Rewards",
    "slug": "hiralal-rewards",
    "scheme": "hiralal-rewards",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand_logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/brand_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "package": "com.hiralal.rewards",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand_logo.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/brand_logo.png"
    },
    "plugins": [
      "expo-asset",
      "./plugins/withPlayIntegrity",
      "./plugins/withReleaseSigning",
      "./plugins/withDeveloperModeSecurity",
      "./plugins/withNetworkSecurityConfig",
      [
        "expo-notifications",
        {
          "icon": "./assets/brand_logo.png",
          "color": "#1E60D5"
        }
      ]
    ]
  }
}
