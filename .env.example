# ==============================================================================
# HIRALAL AND SONS SALES PVT. LTD. - PRODUCTION ENVIRONMENT CONFIGURATION
# Platform: AWS EC2 t4g.medium (2 vCPU, 4 GiB RAM, ARM64 / Graviton2, ap-south-1)
# Copy to .env for production deployment or Docker Compose execution
# ==============================================================================

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=hiralal_postgres_production_password_2026_secure
POSTGRES_DB=hiralal_rewards

# JWT Secrets (Generate using: openssl rand -hex 32)
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# Cryptographic Keys (Field Encryption AES-256-GCM + Database Encryption)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
STORAGE_HMAC_SECRET=hiralal_secure_storage_hmac_signing_key_2026_prod

# Cloudflare R2 Private S3-Compatible Storage
R2_ACCESS_KEY_ID=cf_r2_access_key_placeholder
R2_SECRET_ACCESS_KEY=cf_r2_secret_access_key_placeholder
R2_BUCKET_NAME=hiralal-invoices-private
R2_ENDPOINT=https://account_id.r2.cloudflarestorage.com

# SignCare PAN KYC Verification Gateway
SIGNCARE_API_KEY=signcare_api_key_placeholder
SIGNCARE_APP_ID=signcare_app_id_placeholder

# RazorpayX Current Account Banking & Payouts
RAZORPAYX_KEY_ID=rzp_live_placeholder
RAZORPAYX_KEY_SECRET=rzp_live_secret_placeholder
RAZORPAYX_ACCOUNT_NUMBER=2323230041123456
RAZORPAYX_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# MSG91 Transactional OTP SMS Gateway (DLT Approved)
MSG91_AUTH_KEY=msg91_auth_key_placeholder
MSG91_TEMPLATE_ID=msg91_dlt_template_placeholder

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://hiralalandsons.com,https://admin.hiralalandsons.com,http://localhost:3000

# Initial Admin User Credentials
ADMIN_INITIAL_PASSWORD=HiralalAdminSecure2026!
