# ==============================================================================
# HIRALAL AND SONS SALES PVT. LTD. - PRODUCTION ENVIRONMENT CONFIGURATION
# Platform: AWS EC2 t4g.medium (2 vCPU, 4 GiB RAM, ARM64 / Graviton2, ap-south-1)
# Copy to .env for production deployment or Docker Compose execution
# NOTE: Replace all REPLACE_WITH_* placeholders with cryptographically secure values.
# ==============================================================================

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_POSTGRES_PASSWORD
POSTGRES_DB=hiralal_rewards

# Redis 7+ Cache & BullMQ Queue
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD

# JWT Secrets (Generate using: openssl rand -hex 32)
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_REFRESH_SECRET
JWT_ADMIN_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_ADMIN_ACCESS_SECRET

# Administrative Role Prefixes (Configured, not hardcoded)
BILL_ADMIN_PREFIX=BADM
OPERATIONS_ADMIN_PREFIX=OADM

# Cryptographic Keys (Field Encryption AES-256-GCM + Database Encryption)
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_ENCRYPTION_KEY
FIELD_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_FIELD_ENCRYPTION_KEY
STORAGE_HMAC_SECRET=REPLACE_WITH_SECURE_STORAGE_HMAC_SECRET

# Cloudflare R2 Private S3-Compatible Storage
R2_ACCESS_KEY_ID=REPLACE_WITH_CF_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_CF_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=hiralal-invoices-private
R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com

# SignCare PAN KYC Verification Gateway
SIGNCARE_BASE_URL=https://api.signcare.in
SIGNCARE_API_KEY=REPLACE_WITH_SIGNCARE_API_KEY
SIGNCARE_APP_ID=REPLACE_WITH_SIGNCARE_APP_ID

# RazorpayX Current Account Banking & Payouts
RAZORPAYX_KEY_ID=REPLACE_WITH_RAZORPAYX_KEY_ID
RAZORPAYX_KEY_SECRET=REPLACE_WITH_RAZORPAYX_KEY_SECRET
RAZORPAYX_ACCOUNT_NUMBER=REPLACE_WITH_RAZORPAYX_ACCOUNT_NUMBER
RAZORPAYX_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAYX_WEBHOOK_SECRET

# MSG91 Transactional OTP SMS Gateway (DLT Approved)
MSG91_AUTH_KEY=REPLACE_WITH_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=REPLACE_WITH_MSG91_TEMPLATE_ID

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://hsspl.algions.in,http://localhost:3000

# Initial Admin User Credentials & Bootstrap Mobiles
BILL_ADMIN_MOBILE=REPLACE_WITH_PRODUCTION_BILL_ADMIN_10DIGIT_MOBILE
OPERATIONS_ADMIN_MOBILE=REPLACE_WITH_PRODUCTION_OPERATIONS_ADMIN_10DIGIT_MOBILE
BILL_ADMIN_INITIAL_PASSWORD=REPLACE_WITH_INITIAL_BILL_ADMIN_PASSWORD
OPERATIONS_ADMIN_INITIAL_PASSWORD=REPLACE_WITH_INITIAL_OPERATIONS_ADMIN_PASSWORD
