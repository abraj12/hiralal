# ==============================================================================
# HIRALAL AND SONS SALES PVT. LTD. - PRODUCTION ENVIRONMENT CONFIGURATION
# Platform: Hostinger KVM 2 VPS (2 vCPU, 8 GiB RAM, 100 GB NVMe, Ubuntu x86_64)
# Copy to .env for production deployment or Docker Compose execution
# NOTE: Replace all REPLACE_WITH_* placeholders with cryptographically secure values.
# ==============================================================================

# Stack Deployment Image Tag (defaults to local for development and CI smoke test)
HIRALAL_IMAGE_TAG=local

# PostgreSQL 16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_SECURE_POSTGRES_PASSWORD
POSTGRES_DB=hiralal_rewards

# Redis 7+ Cache & BullMQ Queue
REDIS_PASSWORD=REPLACE_WITH_SECURE_REDIS_PASSWORD

# JWT Secrets (Generate using: openssl rand -hex 32)
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_REFRESH_SECRET
JWT_ADMIN_ACCESS_SECRET=REPLACE_WITH_64_CHAR_HEX_JWT_ADMIN_ACCESS_SECRET

# Cryptographic Keys (Field Encryption AES-256-GCM + Database Encryption)
ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_ENCRYPTION_KEY
FIELD_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_FIELD_ENCRYPTION_KEY
BLIND_INDEX_SECRET=REPLACE_WITH_64_CHAR_HEX_BLIND_INDEX_SECRET
STORAGE_HMAC_SECRET=REPLACE_WITH_SECURE_STORAGE_HMAC_SECRET
OTP_HMAC_SECRET=REPLACE_WITH_64_CHAR_HEX_OTP_HMAC_SECRET

# Automated Database Backup Encryption Passphrase
BACKUP_ENCRYPTION_PASSPHRASE=REPLACE_WITH_SECURE_PASSPHRASE_MIN_16_CHARS

# Cloudflare R2 Private S3-Compatible Storage
R2_ACCESS_KEY_ID=REPLACE_WITH_CF_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_CF_R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=hiralal-invoices-private
R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com

# SignCare PAN KYC Verification Gateway
SIGNCARE_BASE_URL=https://api.signcare.in
SIGNCARE_API_KEY=REPLACE_WITH_SIGNCARE_API_KEY
SIGNCARE_APP_ID=REPLACE_WITH_SIGNCARE_APP_ID

# RazorpayX Current Account Banking & Payouts
RAZORPAYX_KEY_ID=REPLACE_WITH_RAZORPAYX_KEY_ID
RAZORPAYX_KEY_SECRET=REPLACE_WITH_RAZORPAYX_KEY_SECRET
RAZORPAYX_ACCOUNT_NUMBER=REPLACE_WITH_RAZORPAYX_ACCOUNT_NUMBER
RAZORPAYX_WEBHOOK_SECRET=REPLACE_WITH_RAZORPAYX_WEBHOOK_SECRET

# WhatsApp Business Platform Cloud API (Phone Verification OTP)
OTP_PROVIDER=WHATSAPP
WHATSAPP_API_URL=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=REPLACE_WITH_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_WHATSAPP_PERMANENT_ACCESS_TOKEN
WHATSAPP_BUSINESS_ACCOUNT_ID=REPLACE_WITH_WHATSAPP_BUSINESS_ACCOUNT_ID
WHATSAPP_TEMPLATE_NAME=hiralal_auth_otp
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_AUTH_BUTTON_TYPE=COPY_CODE

# Optional Legacy MSG91 SMS Transport Fallback
MSG91_AUTH_KEY=REPLACE_WITH_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=REPLACE_WITH_MSG91_TEMPLATE_ID

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://hsspl.algions.in,http://localhost:3000

# Two Admin Architecture (Strictly BILL_ADMIN and OPERATIONS_ADMIN only)
BILL_ADMIN_PREFIX=BADM
OPERATIONS_ADMIN_PREFIX=OADM
NEXT_PUBLIC_BILL_ADMIN_PREFIX=BADM
NEXT_PUBLIC_OPERATIONS_ADMIN_PREFIX=OADM
BILL_ADMIN_MOBILE=REPLACE_WITH_PRODUCTION_BILL_ADMIN_10DIGIT_MOBILE
OPERATIONS_ADMIN_MOBILE=REPLACE_WITH_PRODUCTION_OPERATIONS_ADMIN_10DIGIT_MOBILE
BILL_ADMIN_INITIAL_PASSWORD=REPLACE_WITH_INITIAL_BILL_ADMIN_PASSWORD
OPERATIONS_ADMIN_INITIAL_PASSWORD=REPLACE_WITH_INITIAL_OPERATIONS_ADMIN_PASSWORD
ADMIN_ACCESS_TOKEN_EXPIRES_IN=1d

# Authentication & Lockout Security Thresholds
AUTH_LOCKOUT_SECONDS=900
AUTH_MAX_FAILED_ATTEMPTS=10
OTP_TTL_SECONDS=300
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# File Upload & Document Storage Limits
BILL_MAX_UPLOAD_SIZE_MB=10
BILL_MAX_AMOUNT=50000000
R2_SIGNED_URL_TTL_SECONDS=1800
UPLOADS_DIR=/app/uploads

# Account Deletion Lifecycle & Grace Periods
ACCOUNT_DELETION_COOLDOWN_DAYS=30
ACCOUNT_DELETION_GRACE_PERIOD_DAYS=7

# Background Worker Intervals (Milliseconds)
WORKER_PAYOUT_POLL_INTERVAL_MS=5000
WORKER_RECONCILIATION_INTERVAL_MS=180000
WORKER_DELETION_INTERVAL_MS=60000

# Rate Limiting Configuration
KYC_RATE_LIMIT=5
KYC_RATE_WINDOW_SECONDS=3600
PAYMENT_VERIFY_RATE_LIMIT=5
PAYMENT_VERIFY_WINDOW_SECONDS=3600
PAYOUT_REDEEM_RATE_LIMIT=3
PAYOUT_REDEEM_WINDOW_SECONDS=60

# Application Timezone
APP_TIMEZONE=Asia/Kolkata

# Firebase Cloud Messaging HTTP v1 Push Notifications
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY="REPLACE_WITH_FIREBASE_PRIVATE_KEY"
# Alternatively, specify path to service account JSON:
# FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/firebase-service-account.json

# Google Play Integrity API (Android Mobile Anti-Tampering & Security Attestation)
PLAY_INTEGRITY_CLIENT_EMAIL=REPLACE_WITH_PLAY_INTEGRITY_CLIENT_EMAIL
PLAY_INTEGRITY_PRIVATE_KEY="REPLACE_WITH_PLAY_INTEGRITY_PRIVATE_KEY"
PLAY_INTEGRITY_PACKAGE_NAME=com.hiralal.rewards
PLAY_INTEGRITY_ALLOWED_CERT_DIGESTS=REPLACE_WITH_SHA256_CERT_DIGEST
PLAY_INTEGRITY_ALLOW_MOCK=false
PLAY_INTEGRITY_REQUIRE_LICENSING=true
PLAY_INTEGRITY_ENFORCE_ACTIONS=true

